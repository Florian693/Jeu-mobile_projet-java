<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- COUCHE 1 : le fond -->
    <ImageView
        android:id="@+id/imgFond"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_menu"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- COUCHE 2 : le logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/logo_titre"
        android:adjustViewBounds="true"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.8" />

    <!-- COUCHE 3 : les boutons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnJouer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="JOUER"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="14dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnOptions" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnOptions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="OPTIONS"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="14dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="120dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuitter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="QUITTER"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>