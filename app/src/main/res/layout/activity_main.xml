<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Ligne de guidage : le logo au-dessus, les boutons en dessous -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideBoutons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <!-- COUCHE 1 : le fond -->
    <ImageView
        android:id="@+id/imgFond"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/menu_paysage"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- COUCHE 2 : le logo (reste entier dans la moitie haute) -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/logo_titre"
        android:scaleType="fitCenter"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideBoutons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.6" />

    <!-- COUCHE 3 : les 2 boutons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnJouer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="JOUER"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintTop_toBottomOf="@id/guideBoutons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnQuitter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="QUITTER"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintTop_toBottomOf="@id/btnJouer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>