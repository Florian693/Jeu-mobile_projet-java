<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/options_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OptionsActivity">

    <!-- Fond -->
    <ImageView
        android:id="@+id/imgFondOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_menu"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Titre de l'écran -->
    <TextView
        android:id="@+id/txtTitreOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPTIONS"
        android:fontFamily="@font/press_start_2p"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bouton Langue -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLangue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="LANGUE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:layout_marginTop="60dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintTop_toBottomOf="@id/txtTitreOptions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bouton Volume -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="VOLUME"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="14dp"
        android:layout_marginTop="24dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintTop_toBottomOf="@id/btnLangue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bouton Retour -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRetourOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="RETOUR"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>