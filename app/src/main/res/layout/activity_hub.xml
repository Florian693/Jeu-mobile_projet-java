<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HubActivity">

    <ImageView
        android:id="@+id/imgFond"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_menu"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Titre -->
    <TextView
        android:id="@+id/txtTitreHub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/titre_cadre"
        android:fontFamily="@font/press_start_2p"
        android:text="Sélectionnez une partie"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="16dp"
        android:lineSpacingExtra="8dp"
        android:layout_marginTop="120dp"
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Slot 1 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSlot1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="SLOT 1 : VIDE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="14dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSlot2" />

    <!-- Slot 2 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSlot2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="SLOT 2 : VIDE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="14dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSlot3" />

    <!-- Slot 3 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSlot3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="SLOT 3 : VIDE"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="14dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRetour" />

    <!-- Retour -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRetour"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_pixel"
        android:fontFamily="@font/press_start_2p"
        android:text="RETOUR"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="14dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>