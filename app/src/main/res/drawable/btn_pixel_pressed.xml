<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ombre réduite -->
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#001252" />
        </shape>
    </item>

    <!-- Bouton décalé vers l'ombre, couleur plus sombre -->
    <item android:left="4dp" android:top="4dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#004CCC" />
            <stroke android:width="4dp" android:color="#61DBFA" />
        </shape>
    </item>

</layer-list>