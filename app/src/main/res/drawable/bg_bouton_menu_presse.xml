<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ombre réduite : le bouton est enfoncé -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#66000000"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Bouton plus sombre, décalé vers le bas -->
    <item android:top="2dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#071433"/>
            <stroke android:width="2dp" android:color="#8A98B8"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>